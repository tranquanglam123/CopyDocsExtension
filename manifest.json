{
  "manifest_version": 3,
  "name": "CopyDocExt",
  "version": "2.1.0",
  "description": "Download & copy content from restricted Google Docs and Sheets, and the PDF/Word material web pages embed.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CopyDocExt - Extract Restricted Docs"
  },
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads",
    "declarativeNetRequest",
    "notifications",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "*://docs.google.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/*/mobilebasic*"
      ],
      "js": [
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}